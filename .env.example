# ── Required ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here        # Free at https://console.groq.com — no credit card
GROQ_MODEL=llama-3.3-70b-versatile    # Best quality on Groq free tier

# ── Optional (defaults shown) ─────────────────────────────────────────────────
GROQ_TEMPERATURE=0
GROQ_MAX_TOKENS=1024

EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DEVICE=cpu

MLFLOW_TRACKING_URI=sqlite:///mlruns.db
MLFLOW_EXPERIMENT_NAME=llmops-starter-kit

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

PROMPTS_DIR=prompts

DRIFT_WINDOW_SIZE=5
DRIFT_Z_THRESHOLD=1.5

DEFAULT_FAITHFULNESS_THRESHOLD=0.70
DEFAULT_LATENCY_THRESHOLD_MS=3000
DEFAULT_RELEVANCY_THRESHOLD=0.65
